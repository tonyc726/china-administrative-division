{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "全仓共享编译配置的唯一真相源；各包 tsconfig.json 通过 extends 引用，只覆写 outDir/rootDir/references。",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  }
}
