{
  "name": "@cndiv/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "China Division Time Machine — standalone nested workspace. React/Vite deps stay out of the monorepo lockfile.",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "data": "bun scripts/build-data.ts",
    "dev": "bun scripts/build-data.ts && bun scripts/build-coords.ts && vite",
    "build": "bun scripts/build-data.ts && bun scripts/build-coords.ts && tsc -b && vite build && bun scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "pinyin-pro": "^3.28.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
