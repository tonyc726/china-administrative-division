{
  "name": "@cndiv/monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"scripts/**/*.{mjs,ts}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "clean": "tsc -b --clean",
    "validate-patches": "node scripts/validate-patches.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^2.8.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
