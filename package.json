{
  "name": "@cndiv/monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"scripts/**/*.{mjs,ts}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "clean": "tsc -b --clean",
    "validate-patches": "node scripts/validate-patches.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^24.0.0",
    "prettier": "^3.8.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@3": "^3.15.0"
    }
  }
}
