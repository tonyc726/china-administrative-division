{
  "name": "@cndiv/cli",
  "version": "1.0.0",
  "description": "CLI tool for data hydration, migration and export",
  "type": "module",
  "bin": {
    "cndiv": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "hydrate": "tsx src/cli.ts hydrate",
    "migrate": "tsx src/scripts/migrate-legacy.ts",
    "build-source": "tsx src/scripts/build-source.ts"
  },
  "peerDependencies": {
    "@cndiv/core": "workspace:*",
    "@cndiv/data-protocol": "workspace:*"
  },
  "dependencies": {
    "@cndiv/core": "workspace:*",
    "@cndiv/data-protocol": "workspace:*",
    "better-sqlite3": "^9.4.0",
    "cacache": "^18.0.0",
    "got": "^14.0.0",
    "tar-stream": "^3.1.0"
  },
  "devDependencies": {
    "@cndiv/core": "workspace:*",
    "@cndiv/data-protocol": "workspace:*",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.0.0",
    "@types/tar-stream": "^3.1.0"
  },
  "keywords": ["china", "administrative", "division", "cli"],
  "license": "MIT"
}
