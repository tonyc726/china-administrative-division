{
  "name": "@cndiv/crawler",
  "version": "1.0.0",
  "description": "后统计局时代增量采集引擎：对接国家地名信息库(dmfw)抓取并差分产出 Patch",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cndiv-crawl": "dist/run.js",
    "cndiv-postal": "dist/run-ip138.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "crawl": "tsx src/run.ts",
    "crawl:postal": "tsx src/run-ip138.ts"
  },
  "dependencies": {
    "@cndiv/core": "workspace:*",
    "@cndiv/data-protocol": "workspace:*",
    "cheerio": "^1.0.0",
    "got": "^14.0.0"
  },
  "keywords": ["china", "administrative", "division", "crawler", "mca"],
  "license": "MIT"
}
